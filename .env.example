# ─────────────────────────────────────────────────────────────
# divine-sense-agent .env.example
# Copy to `.env` and fill in. NEVER hardcode secrets in source.
# ─────────────────────────────────────────────────────────────

# Qdrant server
# v0.9.25.1: 建議用 127.0.0.1(IPv4 literal)。`localhost` 在多數
# Windows 環境先解析到 ::1,若 loopback IPv6 的 connect 被拒有延遲,
# qdrant-client 每個請求都重連,每次都會多付該延遲(本機實測
# 2073ms → 29ms)。config.py 會自動把 localhost 換成 127.0.0.1;
# 真的要用 IPv6 loopback 請明確寫 [::1]。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=file_docs
# 4096 = Qwen3-Embedding-8B native dim (v0.2.5+, served by llama.cpp).
# 1536 = OpenAI text-embedding-3-small (padded/truncated to 4096).
# 384  = legacy hash-fallback.
EMBEDDING_DIM=4096

# Embedding backend selection (v0.2.6+).
# Allowed values:
#   local  — local llama.cpp server at LLAMACPP_EMBED_URL
#            (Qwen3-Embedding-8B, 4096-dim; default).
#   ollama — Ollama Cloud / local server at OLLAMA_BASE_URL,
#            using OLLAMA_EMBED_MODEL (default nomic-embed-text, 768-dim).
#   openai — OpenAI-compatible API (text-embedding-3-small, 1536-dim).
#   hash   — deterministic hash fallback (NOT semantic).
#   auto   — probe openrouter → openai → hash.
#            (v0.9.51.0: llama.cpp 與 ollama 均已移出 auto 鏈 —
#            RX 5700 XT Vulkan 管線在運行中反覆劣化（同一 chunk
#            334ms → 13,259ms）,ollama.com embeddings 404/401。
#            EMBEDDING_BACKEND=local / ollama 仍可明確指定。)
# Switch by ``set EMBEDDING_BACKEND=ollama`` + ``set QDRANT_COLLECTION=docs_ollama``
# before ``recreate-collection`` + ``ingest`` to use a different collection.
EMBEDDING_BACKEND=auto
# v0.9.25.3: 用 127.0.0.1(IPv4 literal),不要用 localhost — 與
# QDRANT_URL 同一個 ::1 loopback 延遲陷阱(embedder 每次
# requests.post 都新開連線,bare `localhost` 每次多付 ~2 秒;
# embedder 端也會自動正規化,但請直接寫對)。
LLAMACPP_EMBED_URL=http://127.0.0.1:8080/v1/embeddings
# v0.9.115.2: OpenRouter fallback 嵌入模型（重用 OPENROUTER_API_KEY）—
# 選「與主嵌入同模型」的變體：4B 主嵌入（EMBEDDING_DIM=2560）設
# qwen/qwen3-embedding-4b → fallback 維度精確一致（live 證實 HTTP 200
# 原生 2560d、DeepInfra）；預設 qwen/qwen3-embedding-8b（4096d —
# 8B 時代主嵌入相容；對 2560d collection 會被 pad = 語意劣化）。
#OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-4b

# ── local llama.cpp 嵌入長度護欄 (v0.9.66.1+) ──
# 超過上限的文字在送進 llama.cpp 前截斷 — 防止長文本（例:排程任務的
# 長回答）超過伺服器的嵌入 slot ctx（本機實測 n_ctx=1024 → 長文本
# 400 exceed_context_size_error → 觸發 EMBEDDER_BACKEND_COOLDOWN,
# 300 秒內所有嵌入退到 OpenRouter）。預設 950 字（實測 0.78-1.0
# token/字,安全低於 1024 tokens）;0 = 停用截斷。治本之道是調高
# llama.cpp 啟動參數 --ctx-size（C:\llama.cpp\start-llamacpp-8b.bat）。
#QDRANT_EMBED_LOCAL_MAX_CHARS=950

# ── Embedder backend failure cooldown (v0.9.48.0+) ──
# auto 鏈上任一 backend 的 embeddings 呼叫硬失敗後（例:llama.cpp Vulkan
# ErrorDeviceLost — 程序活著、/v1/models 仍 200,但每次 POST 都 500;
# 或 ollama.com 的 /v1/embeddings 404）,該 backend 會被跳過 N 秒,
# 不再每次 embed 都白付失敗 HTTP 往返。預設 300 秒;0 = 不啟用
# （每次都重試 = 0.9.47 行為）。backend 恢復後下一次成功會立即清除冷卻。
# 另:v0.9.48.0 起 Ollama backend 在 /embeddings 404 時自動改試原生
# /api/embed 端點;降級向量改以「實際 backend」入 disk cache,
# 不再污染健康 backend 的快取鍵。
#EMBEDDER_BACKEND_COOLDOWN=300

# ── llama.cpp 嵌入看門狗 (v0.9.112.0+) ──
# 每 interval 秒打「真實嵌入 POST」— GET /v1/models 探不到殭屍狀態
# （程序活著、/v1/models 仍 200,但每次 POST /v1/embeddings 都失敗,
# 例如 Vulkan ErrorDeviceLost）。連續 2 次失敗（streak,預設 2）→
# 殺掉佔用嵌入埠的 llama-server PID（netstat -ano 解析 → taskkill
# /F /T）並 detached 重啟 QDRANT_LLAMACPP_START_BAT、等就緒（≤150 秒）。
# 只信 HTTP 結果「不信延遲」（ingest 跑大 batch 時健康伺服器也會
# 慢,延遲判定會誤殺）;重啟冷卻 600 秒防迴圈。預設 on（GUI/web 開機
# 自動啟動;off = 完全不啟動 thread,get_runtime_status 仍報狀態）。
#   QDRANT_LLAMACPP_WATCHDOG              on (預設) | off
#   QDRANT_LLAMACPP_WATCHDOG_INTERVAL     探針週期秒數（預設 1800）
#   QDRANT_LLAMACPP_START_BAT             啟動器覆寫（預設
#                                         C:\llama.cpp-vulkan\
#                                         start-llamacpp-8b.bat,
#                                         fallback C:\llama.cpp\）
#QDRANT_LLAMACPP_WATCHDOG=on
#QDRANT_LLAMACPP_WATCHDOG_INTERVAL=1800
#QDRANT_LLAMACPP_START_BAT=C:\llama.cpp-vulkan\start-llamacpp-4b.bat
# ↑ v0.9.113.1: 主嵌入是 4B 時必須設 — 否則看門狗重啟會拉起預設 8B
#   bat，4096d 向量被 pad 進 2560d collection（形狀探針驗不出 dim 差）。
# v0.9.115.1: 連線被拒（refused）= 明確死亡 — 埠上什麼都沒有（載模型
# 中的 llama-server 會先綁埠回 HTTP 503 loading，不會 refused）→
# 免等 2-streak、第一次失敗就立即重啟（tasklist 查無 llama-server.exe
# 才動作 — 活程序 + 關閉埠 = 可能還在載模型，防誤殺;600s 冷卻照舊）。
#   QDRANT_LLAMACPP_WATCHDOG_REFUSED_HEAL  on（預設）| off（回 2-streak 行為）
#QDRANT_LLAMACPP_WATCHDOG_REFUSED_HEAL=on
# v0.9.122.2: gemma2 媒體伺服器（:8081）看門狗 — 同一組
# QDRANT_LLAMACPP_WATCHDOG_* 旋鈕共用；自己的 bat/URL/閘門如下。
# 閘門空白 = 跟隨 QDRANT_MEDIA_EMBEDDING（媒體側通道關閉時不養它）。
#   QDRANT_GEMMA2_WATCHDOG               空白（跟隨媒體閘）| on | off
#   QDRANT_GEMMA2_START_BAT              啟動器覆寫（預設
#                                        C:\llama.cpp-un\
#                                        start-llamacpp-gemma2.bat）
#QDRANT_GEMMA2_WATCHDOG=on
#QDRANT_GEMMA2_START_BAT=C:\llama.cpp-un\start-llamacpp-gemma2.bat

# ── hash 向量污染控制 (v0.9.112.0+) ──
# pipeline 把實際產出向量的 backend 記進 payload.embedding_backend;
# 審計/重嵌:Admin Embedding 卡片按鈕或
#   python cli.py audit-backends   （唯讀掃描 + 列出 hash 向量點）
#   python cli.py reembed-hash     （用目前健康 backend 重嵌 +
#                                   更新標記;快取繞過）
# 審計用「重算 hash 向量與存點精確比對」啟發式 — 標記不存在/錯誤的
# 舊資料點也偵測得到。QDRANT_EMBED_FAIL_CLOSED=on 在嵌入退到 hash
# 時直接跳過該檔（ingest 明確報錯）,不寫污染向量;預設 off = 標記後
# 繼續（與舊版行為相同）。
#QDRANT_EMBED_FAIL_CLOSED=on

# ── STAIR 標題層級 metadata (v0.9.113.0+) ──
# QDRANT_HEADING_METADATA=on → ingest 走 heading-aware：DOCX Heading 樣式
# 轉 ATX ``#`` 行、分塊以標題段落切分、每點 payload 帶 heading_path
# （「H1 > H2」堆疊）。會改變分塊邊界 → 下次對同檔 ingest 重嵌一次。
# 既有舊點走「只補 metadata 不重嵌」：
#   python cli.py backfill-headings [--force] [--collection X]
#   或 Admin 頁 Embedding 卡「§ Backfill headings」按鈕。
#QDRANT_HEADING_METADATA=on
# QDRANT_HEADING_BOOST = 搜尋側浮點加成（預設 0 = off）：heading_path
# 與 query 詞重疊的命中分數 +boost 再排序（在 rerank 之前；開
# QDRANT_RERANK 時 Jev 精排優先）。建議 0.05–0.15。
#QDRANT_HEADING_BOOST=0.1
# v0.9.114.0: 多模態側通道 — 規則：「文件附圖/音訊與獨立媒體檔用
# EmbeddingGemma 2（768d 統一空間，文字 query 也能找媒體向量），
# 文字一律走 Qwen3-4B 主路」。媒體嵌入用獨立 server
# C:\llama.cpp-un\start-llamacpp-gemma2.bat（unsloth b11443 fork
# + --mmproj，port 8081）。⚠ v0.9.122.1 查證：上游媒體嵌入已通
# （llama.cpp #30054、b11457+ build；ggml-org#30082 為形狀誤報已撤回，
# 正確形狀 = 巢式 content parts — 本專案 media_embed 已改為優先嘗試）。
# 惟 legacy 形狀（內部 /embedding + image_data；淺層 input）在部分
# build 上仍可能 HTTP 200 回字面 marker 的純文字向量（不同圖
# cos≈1.0）→ media_embed 的假成功自檢（兩張參考圖 cos > 0.999 =
# 判不可用）通過前不會寫媒體點；✅ 2026-10-13：預建已升級
# unsloth b11541-mix-2500203（舊 b11443-mix 存 _old_b11443\）＝開
# gate 即通（live 探針 cos 0.8795 = REAL）；描述文字路
# （DESCRIBE_IMAGES → Qwen3 文字池）照常工作 = 媒體語意已在主池。
#QDRANT_MEDIA_EMBEDDING=on
#QDRANT_MEDIA_INGEST=on
#QDRANT_MEDIA_COLLECTION=media_docs_gemma2
#GEMMA2_EMBED_URL=http://127.0.0.1:8081/v1/embeddings

# ── OpenRouter embeddings (v0.9.49.0+) ──
# auto 鏈順序（v0.9.51.0）: openrouter → openai → hash
# （llama.cpp 與 ollama 已移出 auto 鏈,皆可 EMBEDDING_BACKEND 明確
# 指定）。OpenRouter 的 embeddings 端點（OpenAI 形狀,
# POST /api/v1/embeddings）實測 2026-09-14: qwen/qwen3-embedding-8b
# → 200、原生維度 4096 = 本機 llama.cpp 同模型。重用
# OPENROUTER_API_KEY;有 key 才會探測/使用。也可
# EMBEDDING_BACKEND=openrouter 指定。
#OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
# ── Web search fallback (v0.9.54.0+; server tools since v0.9.84.4) ──
# Ollama hosted web search（web_search / web_fetch）為第一順位;失敗或
# 查無結果時自動改用 OpenRouter 的 web plugin（Exa 搜尋,~$0.007/次,
# 經 chat completions 的 url_citation annotations 取回結果;需
# OPENROUTER_API_KEY,已設即啟用）。WEB_SEARCH_FALLBACK=off 可關閉
# 備援（回到 0.9.53 行為）。
# v0.9.84.4 — OpenRouter server tools（beta）：fetch 改走
# openrouter:web_fetch（OpenRouter 伺服器端抓取+擷取,實測可靠;需
# 真 tool-calling 模型,預設 openai/gpt-4o-mini ~$0.00007/次;最後仍
# 降級 direct GET）。search 的 beta server tool 為 opt-in（實測模型
# 不會主動呼叫）——OPENROUTER_WEB_SEARCH_MODE=server 才先試。
#WEB_SEARCH_FALLBACK=on
#OPENROUTER_WEB_MODEL=meta-llama/llama-3.1-8b-instruct
#OPENROUTER_WEB_SEARCH_MODE=plugin            # plugin | server (beta)
#OPENROUTER_WEB_SEARCH_ENGINE=exa             # server 模式的引擎
#OPENROUTER_WEB_FETCH_MODEL=openai/gpt-4o-mini
#OPENROUTER_WEB_FETCH_ENGINE=                 # 空 = auto（預設）
# ── Web fetch 批次 + Ollama 端點冷卻（v0.9.85.0+） ──
#   OLLAMA_WEB_ENDPOINT_COOLDOWN_S  ollama web 端點 404 後的冷卻秒數
#     （預設 300；0=off）— 端點掛掉時 web_fetch/web_search 直接跳過
#     死腿，不再每次白付 404 來回（2026-09-22 live log 教訓）。
#   QDRANT_WEB_FETCH_BATCH_MAX      web_fetch_batch 的 URL 上限（預設 8）
#   QDRANT_STOCK_BATCH_MAX          stock_get_quotes 的標的上限（預設 10）
#OLLAMA_WEB_ENDPOINT_COOLDOWN_S=300
#QDRANT_WEB_FETCH_BATCH_MAX=8
#QDRANT_STOCK_BATCH_MAX=10
# ── Jev 探索放棄閘（v0.9.85.0+；工具迴圈） ──
# 工具呼叫連續 N 次空結果/錯誤（鏡像站失效）→ 一次 Jev noul 判斷
# 「是否該停止嘗試變體、改用現有資料作答」→ on 且 p ≥ PROB 時注入
# 「停止探索」system note（不拔工具）。shadow 先累積判斷資料。
#   QDRANT_JEV_ABANDON          off 預設 | shadow | on
#   QDRANT_JEV_ABANDON_PROB     0.75
#   QDRANT_JEV_ABANDON_STREAK   3
#QDRANT_JEV_ABANDON=shadow
# ── Agentic-RAG slices（v0.9.86.0+；皆預設 off） ──
#   ① QDRANT_REWRITE          off | shadow | on — 檢索前查詢改寫閘
#     （Retriever.search：一次 jev_noul 判斷「需要改寫嗎」，需要時一次
#     便宜 LLM 把口語問題改寫成檢索查詢；shadow 記 log 不套用）
#   QDRANT_REWRITE_PROB       0.6
#   QDRANT_REWRITE_MODEL      openai/gpt-4o-mini
#   ② QDRANT_SUPPORT_CHECK    off | shadow | on — 答案支持驗證
#     （有用 RAG 內容的答案：一次 jev_noul 判斷「含未受支持的斷言?」，
#     on 且 p ≥ PROB 時一次無工具糾正回合、僅依檢索內容重寫；
#     失敗保留原答案）
#   QDRANT_SUPPORT_CHECK_PROB 0.7
#QDRANT_REWRITE=shadow
#QDRANT_SUPPORT_CHECK=shadow
# ── Hybrid search（v0.9.87.0+；off = 純 dense，byte-identical） ──
#   QDRANT_HYBRID  on 時：collection 建立帶 bm25 sparse 欄位（伺服器端
#   IDF = 正統 BM25 權重）、ingest 存雙腿向量、search 用 RRF fusion
#   融合 dense + BM25。**新 collection**：on → recreate-collection →
#   ingest。**既有 corpus**：on → recreate-collection → `cli.py
#   backfill-sparse`（只補 bm25 腿，dense 向量不動、不重跑 embed）。
#   搜尋時任何 fusion 失敗 → 自動 dense 回落。
#QDRANT_HYBRID=on
# ── 結論 grounding guard（v0.9.94.0；防 fake calling 終線） ──
#   QDRANT_RESULT_GROUNDING     off（預設）| shadow | on — 每次成功
#                               派發的工具結果以 uuid 存證；結論時
#                               確定性快篩（答案含存證特徵詞即通過）
#                               → 可疑才一次 Jev 驗證 → 未 grounding
#                               就無工具重寫（僅依存證內容）。
#   QDRANT_RESULT_GROUNDING_PROB   grounded 機率門檻（預設 0.6）
#QDRANT_RESULT_GROUNDING=on
#QDRANT_RESULT_GROUNDING_PROB=0.6
# ── Jev 分類器（v0.9.93.0+；mock-first） ──
#   JEV_MODE                    mock（預設 — 確定性 hash 挑選，不連網）
#                               | live（真實 Jev 決策 — 與 rerank 同後端
#                               openrouter.ai/api/alpha/decisions，重用
#                               OPENROUTER_API_KEY）
#   QDRANT_JEV_CLASSIFY_BATCH_MAX  批次 items 上限（預設 50，1-500）
#   QDRANT_JEV_CLASSIFY_WORKERS    批次並發數（預設 4，1-16）
#   QDRANT_JEV_CLASSIFY_TIMEOUT_S  單筆 Jev 呼叫逾時（預設 10s，2-60）
# 工具：jev_classify（payload_json inline 或 sandbox JSON path；
#   write_result=true 寫結果 JSON 回 sandbox）、jev_schema、
#   jev_classify_status。
#JEV_MODE=mock
#QDRANT_JEV_CLASSIFY_BATCH_MAX=50
#QDRANT_JEV_CLASSIFY_WORKERS=4
#QDRANT_JEV_CLASSIFY_TIMEOUT_S=10
# ── Google Keep 記事本（v0.9.88.0+；mock-first） ──
#   KEEP_MODE               mock（預設 — 模擬記事本，不連網）| local
#                           （v0.9.89.0 自建本地筆記本 — JSON 檔持久
#                           化，免 Google 授權）| live（官方 Keep
#                           API v1 REST — enterprise-only）
#   KEEP_NOTES_PATH         local 模式筆記本儲存檔（預設
#                           $QDRANT_RAG_HOME/notes/notes.json）
#   KEEP_WRITES_ENABLED     live 寫入總開關（預設 off；create/delete
#                           另需每通 confirm=true）
#   KEEP_CLIENT_SECRET_PATH OAuth client secret JSON。v0.9.88.1 起
#                           預設自動沿用 google-calendar 的
#                           GOOGLE_OAUTH_CREDENTIALS 檔（同 client、
#                           同 token）— 除非你想用別的帳戶才需設定。
#   KEEP_TOKEN_PATH         token.json。v0.9.88.1 起預設 =
#                           google_oauth/token.json（與 google-
#                           calendar MCP 共用同一份 token — 一次
#                           consent 涵蓋 calendar+keep scopes）。
# live 啟用 SOP（v0.9.88.1 共用 token 版）：
#   Cloud Console 專案啟用 Google Keep API（calendar 的 secret 沿用）
#   → pip install google-auth-oauthlib
#   → python cli.py keep-auth（一次同意 = calendar + keep scopes）
#   → KEEP_MODE=live + KEEP_WRITES_ENABLED=on → 重啟。
#   ⚠️ 官方 Keep API 是 enterprise-only — 個人帳戶 consent 回
#   invalid_scope；個人使用請用 KEEP_MODE=local（自建筆記本）。
#KEEP_MODE=mock
#KEEP_WRITES_ENABLED=off
#KEEP_CLIENT_SECRET_PATH=
#KEEP_TOKEN_PATH=

# ── OpenRouter embeddings provider 路由（v0.9.52.0+） ──
# embeddings 端點支援與 chat 相同的 provider 物件（order +
# allow_fallbacks）。逗號清單 = provider 順位;未設定 = 不帶 provider
# 物件（零行為變更,由 OpenRouter 自動選）。回應帶 "provider" 欄位
# （實際服務者,會記入 log）。
#   OPENROUTER_EMBED_PROVIDER_ORDER   逗號清單,如 nebius,deepinfra
#   OPENROUTER_EMBED_ALLOW_FALLBACKS  預設 true;false = 只用清單內
#                                     的 provider（都掛了才回錯）
#OPENROUTER_EMBED_PROVIDER_ORDER=nebius,deepinfra
#OPENROUTER_EMBED_ALLOW_FALLBACKS=false

# Ollama embedding model (when EMBEDDING_BACKEND=ollama).
# Other choices: mxbai-embed-large (1024-dim) / all-minilm (384-dim) /
# embeddinggemma (768-dim).
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── LLM providers (v0.8.9+ 4-provider dispatch; 5-provider since v0.9.19.0) ──
# Auto-detection order: ollama → openrouter → siliconflow → openai →
# openai-compat (first non-empty *_API_KEY wins). LLM_PROVIDER forces
# a specific provider. LLM_PROVIDER_CHAIN reorders auto-detect +
# failover (v0.9.18.0+; empty = legacy order).

# OpenAI / any OpenAI-compatible endpoint (escape hatch).
# OPENAI_CHAT_MODEL (v0.9.19.0+) — dedicated model for the openai slot
# (a compat-endpoint model set here no longer poisons LLM_MODEL's
# global override on the other providers).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
#OPENAI_CHAT_MODEL=

# Ollama Cloud (preferred when OLLAMA_API_KEY is set)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_CHAT_MODEL=
OLLAMA_VISION_MODEL=

# OpenRouter (v0.8.9+ - 400+ models via one key).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=

# SiliconFlow (v0.8.9+ — Qwen / DeepSeek / GLM at low cost).
# OpenAI-compatible — same SDK. Vision model separate from chat.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=
SILICONFLOW_VISION_MODEL=

# 5th provider: fully independent OpenAI-compatible endpoint
# (v0.9.19.0+). Coexists with the `openai` slot (two compat endpoints
# at once) and joins LLM_PROVIDER_CHAIN automatically. OPENAI_COMPAT_*
# are REQUIRED — key without base_url raises a clear error.
#OPENAI_COMPAT_API_KEY=
#OPENAI_COMPAT_BASE_URL=
#OPENAI_COMPAT_CHAT_MODEL=

# LLM provider override (v0.8.9+; openai-compat since v0.9.19.0).
# When multiple *_API_KEY env vars are set, force one chat provider.
# Allowed: ollama | openrouter | siliconflow | openai | openai-compat
# Empty = full LLM_PROVIDER_CHAIN order decides primary + failover.
LLM_PROVIDER=

# Provider chain order (v0.9.18.0+) — primary + failover walk follow
# this comma list (case-insensitive; unknown tokens skipped with a
# warning; partial lists append the unlisted providers in default
# relative order — the chain defines PRIORITY, never exclusion).
#LLM_PROVIDER_CHAIN=

# ── File ingestion ──
WATCH_DIR=./documents
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Vision OCR during ingest (image_describer) — needs a vision provider.
DESCRIBE_IMAGES=true
# Per-file size cap (MB) before ingest skips the file. Default 50.
MAX_FILE_SIZE_MB=50

# ── Telegram gateway (v0.8.1+) ──
# send_telegram_message / send_telegram_markdown MCP tools + the
# schedule→Telegram loop. ALLOWED_CHAT_IDS is the security model —
# only these chat ids may receive messages (list_allowed_chats
# introspects it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Telegram bidirectional voice (v0.9.58.0+) ──
# Voice-in: the bot daemon transcribes Telegram voice notes (STT) and
# runs the transcript through the agent; voice-out: the reply is
# synthesized (TTS) and delivered as an OGG/Opus voice note.
# Defaults use the OpenRouter audio endpoints (your OPENROUTER_API_KEY
# is reused automatically; the key resolution is
# TELEGRAM_STT/TTS_API_KEY → OPENROUTER_API_KEY → OPENAI_API_KEY and
# the base URL default follows the key's vendor).
# OGG/Opus ↔ WAV bridging uses ffmpeg (already required by the ONVIF
# tools); without ffmpeg TTS falls back to raw provider output.
# Any OpenAI-compatible whisper/tts endpoint works too (e.g.
# TELEGRAM_STT_BASE_URL=https://api.openai.com/v1 +
# TELEGRAM_STT_API_KEY=sk-...).
#TELEGRAM_STT_API_KEY=
#TELEGRAM_STT_BASE_URL=https://openrouter.ai/api/v1
#TELEGRAM_STT_MODEL=openai/gpt-4o-mini-transcribe
#TELEGRAM_STT_LANGUAGE=
#TELEGRAM_TTS_API_KEY=
#TELEGRAM_TTS_BASE_URL=https://openrouter.ai/api/v1
#TELEGRAM_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
#TELEGRAM_TTS_VOICE=alloy

# ── Scanned-PDF OCR ingest (v0.9.61.0+) ──
# Image-only (scanned) PDFs are detected at ingest and their page
# scans are transcribed through the vision provider chain
# (VISION_PROVIDER_CHAIN — Ollama Cloud → OpenRouter → SiliconFlow →
# OpenAI-compatible); the recognized text is archived like normal
# content (--- Page N (OCR) --- markers, same dedup/hash pipeline).
QDRANT_INGEST_OCR=on
# Hard cap on OCR'd pages per PDF (protects against a 500-page scan).
QDRANT_PDF_OCR_MAX_PAGES=100

# ── Long-term memory (v0.9.59.0+) ──
# Chat Q/A pairs (every persisted session) + whitelisted tool results
# (web_search / web_fetch) + explicit remember_info calls are stored
# into a DEDICATED Qdrant collection as the LLM's long-term memory.
# Every point carries stored_at (ISO + epoch) — the LLM must CITE the
# acquisition time and lifecycle purges key on it. Recall is injected
# into the system prompt each turn (top-k semantic hits).
QDRANT_MEMORY_COLLECTION=memory_docs
QDRANT_MEMORY_ENABLED=on
QDRANT_MEMORY_TOP_K=5
QDRANT_MEMORY_SESSION_INGEST=on
QDRANT_MEMORY_TOOLS=web_search,web_fetch

# ── Telegram voice reply (v0.9.59.0+) ──
# off = voice-in messages are transcribed and answered TEXT-ONLY
# (on = the reply is sent twice: a short spoken voice note + the
# full text; a per-turn 「改用文字回覆」 in the transcript also
# forces text-only for that turn).
QDRANT_TELEGRAM_VOICE_REPLY=on
# v0.9.60.1: the spoken version is a DETERMINISTIC news-style summary
# of the full answer, packed into this char budget (clamped 20-120).
# Sentence boundaries preferred, then clause boundaries, then …-cut.
QDRANT_TELEGRAM_VOICE_MAX_CHARS=50

# ── Sandbox roots (filesystem / log / import MCP tools) ──
# Filesystem MCP read root (default: WATCH_DIR). Write root is
# mandatory for the write tools + exec/archive/open-with tools.
QDRANT_FILESYSTEM_READ_ROOT=
QDRANT_FILESYSTEM_WRITE_ROOT=
# Log-analyzer read sandbox (fallback: filesystem read root → WATCH_DIR).
QDRANT_LOG_ALLOWED_ROOT=
# Import tool read sandbox.
QDRANT_IMPORT_ALLOWED_ROOT=
# v0.9.133.5 — add_document inline/background threshold (MB).
# Files bigger than this are ingested by a DETACHED background task
# (registry source="ingest"; the task panel tracks it, stop_task halts
# it between embed batches, and the terminal notify tells the
# user on Telegram/GUI). 0 = never go background (legacy exact).
# Default 8 = ~120+ page PDFs. 800-page books → background. The tool
# returns {ok, background: true, task_id} immediately.
#QDRANT_ADD_DOCUMENT_INLINE_MAX_MB=8

# ── Stock snapshot store (v0.9.35.0+) ──
# Every successful stock-local query (quote / kline / account / orders)
# auto-saves one summary point here; stock_search_history /
# stock_list_history read it back. Default stock_docs.
QDRANT_STOCK_COLLECTION=

# ── ONVIF cameras (v0.9.37.0+, Phase A READ-ONLY) ──
# Favorite devices + credentials live in this JSON (atomic writes;
# chmod 600 best-effort). Per-device passwords are RECOMMENDED as
# env references (the JSON never holds the secret):
#   ONVIF_FRONTDOOR_PASSWORD=xxxx
#   ONVIF_GARAGE_PASSWORD=xxxx
# (base64-stored passwords are only OBSCURED, not encrypted.)
QDRANT_ONVIF_FAVORITES_FILE=
QDRANT_ONVIF_HTTP_TIMEOUT=10
QDRANT_ONVIF_SNAPSHOT_MAX_BYTES=8388608

# ── OpenRouter provider routing (v0.9.9.2+) ──
# All OpenRouter-only; unset/empty = byte-identical legacy requests.
# Comma lists; invalid tokens skipped with a warning (a typo must
# never take the chat provider down).
#OPENROUTER_PROVIDER_ORDER=together,baseten/fp8
#OPENROUTER_ALLOW_FALLBACKS=false
#OPENROUTER_REQUIRE_PARAMETERS=true
#OPENROUTER_DATA_COLLECTION=deny
#OPENROUTER_IGNORE=modal,makora
#OPENROUTER_QUANTIZATIONS=fp8,int4
#OPENROUTER_SORT=throughput
# Model fast lane: :nitro (max-throughput) / :floor (lowest-price).
#OPENROUTER_MODEL_SUFFIX=:nitro
# Reasoning effort for reasoning models (v0.9.11.1+): minimal|low|medium|high
# (TOP-LEVEL extra_body reasoning; glm endpoints that mandate reasoning
# measured hello ~6s → ~1.5s at effort=low).
#OPENROUTER_REASONING_EFFORT=low

# ── MCP tool-surface gate (v0.9.13.0+; discovery-trap contract since v0.9.13.2) ──
# Comma list of `server_name` values; empty/unset = FULL tool surface.
# Tools from servers NOT listed are HIDDEN from the LLM (v0.9.13.2:
# list_mcp_tools agrees with the declared surface + hidden note).
# Schedule fires still dispatch by-name (hidden tools reachable).
# Version notes:
#   v0.9.21.0: chat-history-local adds the chat-history query tools
#     (list_chat_sessions / search_chat_history / get_chat_session).
#   v0.9.23.0: telegram (from config/mcp.json) adds
#     send_telegram_message / send_telegram_markdown / list_allowed_chats
#     — REQUIRED for schedule prompts that send via Telegram.
#   v0.9.24.0: stock-local adds the 兆豐 stock tools (stock_get_quote /
#     stock_get_kline / stock_get_account_summary / stock_list_orders /
#     stock_place_order / stock_cancel_order) — REQUIRED for stock
#     queries / mock orders; not listed = hidden from the LLM.
#   v0.9.25.0: webhook-local adds the webhook trigger tools
#     (add_webhook_trigger / get_webhook_trigger_url / run_webhook_
#     trigger_now / ...) — REQUIRED for webhook trigger management;
#     not listed = hidden from the LLM.
#   v0.9.37.0: onvif-local adds the ONVIF camera tools (discover /
#     favorites / snapshot / record / PTZ / events / watch — 17 tools
#     since v0.9.41.0). REQUIRED for camera chat control.
#   v0.9.39.0: cred-local adds the central credential-set tools
#     (cred_add/list/get/remove/resolve) — REQUIRED for ONVIF
#     favorites that reference cred_set.
#   v0.9.40.0: netscan-local adds net_scan_hosts / net_scan_ports /
#     net_my_interfaces (private networks only by default).
#   Full-service list (v0.9.41.2) = 17 in-process LocalHosts +
#     config/mcp.json entries. Unknown names are warned + skipped;
#     a typo (e.g. webhook-localhost vs webhook-local) HIDES that
#     server's tools — verify with the boot log line
#     "MCP_ACTIVE_SERVERS unknown servers skipped".
#MCP_ACTIVE_SERVERS=qdrant-local,web-local,filesystem-local,zipfs-local,datetime-local,scheduler-local,todo-local,openwith-local,log-analyzer-local,archive-local,exec-local,chat-history-local,task-local,tacti-local,skill-library-local,meta-local,windows-mcp,telegram,stock-local,hicloud-local,webhook-local,onvif-local,cred-local,netscan-local,runtime-local,drawio,my_web,snippets-local,rulebook-local,pdfcraft,rea,gridcraft,soundcraft,wordcraft,deckcraft,filmcraft
# v0.9.133.13 — archive / zipfs budgets (both servers share these keys):
# total uncompressed bytes and member count of the RESULT archive; a
# single write or extracted member is capped at max_bytes too.
#QDRANT_ARCHIVE_MAX_BYTES=536870912
#QDRANT_ARCHIVE_MAX_FILES=10000

# ── Config hot reload (v0.9.42.0+) ──
# Admin-tab 🔄「重新載入」按鈕與 CLI `reload` 隨時可用；開啟後另有一個
# mtime 輪詢 daemon — .env 或 config/mcp.json 變更時自動 reload +
# 重啟服務 + 重連 MCP fleet（儲存中的編輯會即時生效，但有誤存風險）。
# 注意：從 .env「刪除」變數不會生效（dotenv 不清除 process env），
# 刪除類變更仍需重啟程式。
#
#QDRANT_CONFIG_HOT_RELOAD=off
#QDRANT_CONFIG_WATCH_INTERVAL=10

# ── Tool-loop iteration budget (v0.9.14.1+) ──
# How many LLM tool-calling iterations one ask/chat turn may use before
# the loop forces a final answer. Desktop automation via windows-mcp
# (launch app → snapshot → click → drag → colour → save) needs MANY
# steps; the historical 6 aborted every drawing task mid-way. Default
# when unset: 20. Invalid / non-positive values fall back to the
# default (warning only — never crashes the turn).
#MAX_TOOL_ITERATIONS=20

# ── LLM HTTP request timeout (v0.9.63.1+) ──
# Ceiling for ONE chat/vision LLM HTTP call (primary + every failover
# candidate). The openai-SDK default is 600 s per attempt WITH built-in
# retries — a hung/slow provider call (e.g. a turn whose prompt carries
# a huge tool read-back) froze telegram/scheduler/GUI turns for tens of
# minutes with no reply. Default when unset: 300 s (clamped 30-1200;
# invalid values fall back to the default with a warning only).
# Timeout fires → APITimeoutError → the existing retry /
# cross-provider failover path degrades gracefully.
#QDRANT_LLM_TIMEOUT_S=300

# ── Concurrent turn gate (v0.9.45.0+; 平行多功 Phase 1 安全網) ──
# 限制「整個程序」同時執行的 LLM 對話輪數 — GUI 聊天、排程 fire、
# webhook fire、Telegram bot、CLI 全部共用同一個上限（保護 provider
# rate limit / token 成本 / 本機單一資源工具）。
#   QDRANT_MAX_CONCURRENT_TURNS  空/未設 = 不限（= 既有行為）；
#                                無效或非正整數回落不限（只警告）。
#   QDRANT_TURN_WAIT_SECONDS     佇列等待秒數（預設 120）— 超時回
#                                TurnGateBusy 明確錯誤，不會無限卡住。
# 同一執行緒內的巢狀對話（例如 turn 中呼叫 run_scheduled_task_now 再
# 開一輪）重用同一個名額，max=1 也不會死鎖。設定在首次使用時讀取並
# 快取 — 變更需重啟程序。建議 2~4。
#QDRANT_MAX_CONCURRENT_TURNS=
#QDRANT_TURN_WAIT_SECONDS=120

# ── Tool-result base64 stripping (v0.9.16.2+) ──
# describe_image / resize_image 的回傳含 raw_image_base64（手機照片
# 可達數 MB）。文字-only 的 tool loop 從不消耗這些 bytes，卻會把
# 下一輪請求撐爆 context（OpenRouter 回 404 "No endpoints found"）。
# 預設把工具訊息內的 base64 欄位/長 base64 run 換成
# `<base64 omitted: N chars>`。設 off 可保留原始 bytes。
#AGENT_STRIP_TOOL_BASE64=on

# ── Chat context compression (v0.9.10.0+; OFF by default) ──
# Opt-in. Unset/off keeps chat byte-identical to pre-0.9.10.0.
# CHAT_CONTEXT_COMPRESSION = off | on | aggressive (aggressive halves
#   the trigger + per-message budget).
# CHAT_COMPRESS_TRIGGER_MESSAGES (24) — history older than this folds
#   into ONE system summary; the most recent CHAT_COMPRESS_KEEP_MESSAGES
#   (12) stay verbatim. Summary via LLM (any failure → deterministic
#   extractive fallback), cached per old-prefix sha1 (LRU 8).
# CHAT_OFFLOAD_THRESHOLD_CHARS (20000) — successful tool results over
#   this are written into the read sandbox (chat_offloads/; the tool
#   message becomes a pointer + 800-char preview; errors NEVER offload).
# CHAT_COMPRESS_MSG_MAX_CHARS (4000) — long history messages keep
#   fenced code + JSON verbatim and squeeze only the surrounding prose.
#QDRANT_OFFLOAD_DIR=                # 空 = <read sandbox>/chat_offloads
#CHAT_CONTEXT_COMPRESSION=off
#CHAT_COMPRESS_TRIGGER_MESSAGES=24
#CHAT_COMPRESS_KEEP_MESSAGES=12
#CHAT_COMPRESS_SUMMARY_MODE=llm
#CHAT_COMPRESS_SUMMARY_MAX_CHARS=2000
#CHAT_COMPRESS_MSG_MAX_CHARS=4000
#CHAT_OFFLOAD_THRESHOLD_CHARS=20000

# ── Scheduler daemon auto-resume (v0.9.22.0+) ──
# 排程本身持久化（schedules/*.json），但 daemon 是程序內的 thread —
# 每次重啟 GUI/web 都會死掉，而 v0.8.6.3 的 auto-start 只在「LLM 新增
# 排程」時觸發。v0.9.22.0 起：首次 get_status 輪詢（prewarm）會在
# 「存在 enabled 的排程」時自動恢復 daemon；錯過的 next_fire_at 會在
# 第一次 tick 立即 catch-up 補跑。設 off 可關閉自動恢復。
#QDRANT_SCHEDULER_AUTORESUME=off
; Qdrant server auto-heal (v0.9.109.3) — when the GUI/web boots, the
; prewarm path probes <QDRANT_URL>/readyz; if down AND the URL is a
; loopback address it spawns the start bat detached and waits ~30s.
QDRANT_SPAWN_QDRANT=on
QDRANT_QDRANT_START_BAT=C:\qdrant\start-qdrant.bat
QDRANT_SPAWN_FIREFOX_SERVICE=on
QDRANT_FIREFOX_SERVICE_START_BAT=C:\Users\humphery\coding\mcp_getweb\run_service.bat
; (firefox: probe http://127.0.0.1:8766/health -> spawn the
;  run_service.bat launcher when down; MCP_SERVICE_PORT=8766
;  keeps the probe in sync with the service)
;
; v0.9.115.0 — firefox_craw Fleet（mcp_getweb v6.0，多機／多 Firefox）：
;   本機照舊（loopback only = 現狀全綠）。要組 fleet 時三個面：
;   ① root 機對外開放：MCP_SERVICE_HOST=0.0.0.0（或 LAN IP）＋ MCP_SERVICE_KEY=<密語>
;     （此二值需 setx 到系統服務環境，不能只靠 .env——service 是 schtasks/detached 起的）
;   ② 下層機器：MCP_SERVICE_UPSTREAM_URL=http://<rootIP>:8766 ＋ MCP_SERVICE_NODE_ID=svc-<名>
;     （下層零開埠、outbound 連 root）
;   ③ 各機 server.exe（agent 端呼叫者）帶同一 MCP_SERVICE_KEY（stdio 子程序繼承 .env ✓）
;   工具面：browser_fleet_list() 看機器群；browser_* 工具 target=<browser_id> 選機器。
;MCP_SERVICE_KEY=
;MCP_SERVICE_HOST=0.0.0.0
;MCP_SERVICE_UPSTREAM_URL=
;MCP_SERVICE_NODE_ID=


# ── 使用者自訂 system rules（v0.9.104.6+）──
# 把自訂規則寫進一個檔案，Agent 每次 system prompt 建構時自動附加成
# `USER SYSTEM RULES` 區塊（tools 與 legacy 兩種 prompt 都會帶）。
# 預設：<READ sandbox>/system_rules.md（存在才載入；改檔即生效免重啟）
# 或用 QDRANT_SYSTEM_RULES_FILE 指向任何路徑（支援 ~ 展開）。
# QDRANT_SYSTEM_RULES_MAX_CHARS=8000   # 超過截斷（保護 prompt 大小）
# 規則與工具/安全規則衝突時，工具/安全規則優先（prompt 已標明）。
#QDRANT_SYSTEM_RULES_FILE=

# ── Agent Rulebook（v0.9.124.0+）──
# agent 自己維護的規則簿（Memento-3 rulebook 工件借鏡）：工具失敗=預測錯誤，
# LLM 可用 rules_add/rules_revise 把「環境的系統性事實」寫進可修訂的規則檔，
# 每回合自動上 system prompt（AGENT RULEBOOK 區塊）。REVISE 必須引用證據
# （Evo² 證據門）；寫入前自動快照到 rulebook_history/ ring，可 rules_rollback。
# 預設：READ sandbox 的 agent_rules.md（與 system_rules.md 同位；空白檔 =
# prompt byte-identical，無行為差異）。
#QDRANT_RULEBOOK_ENABLED=on            # 總開關（off = prompt 不附 + 工具拒絕）
#QDRANT_RULEBOOK_FILE=…md              # 指定路徑（支援 ~ 展開）
#QDRANT_RULEBOOK_MAX_CHARS=4000        # prompt 注入截斷保護
#QDRANT_RULEBOOK_SUGGEST=on            # 工具失敗時的修訂提示（每回合一次）
#QDRANT_RULEBOOK_HISTORY_MAX=20        # 快照 ring 深度
#QDRANT_RULEBOOK_MEMORY=on             # 規則事件 sink memory（kind=rule-lesson）
#QDRANT_REFLECT_POSTMORTEM=off         # TACTI 計畫失敗後的 Reflector 事後檢討回
#                                       合（Evo² 雙角色借鏡；opt-in，
#                                       開啟會多燒 LLM tokens）

# ── Schedule-fire context (v0.9.67.1+) ──
# 每次 fire 傳給 LLM 的「歷史」則數。排程 session 會長期重用並累積全部
# fire 記錄；v0.9.67.1 之前每次 fire 都帶「全部」歷史，固定 prompt 重複
# 越多次，模型越容易模仿舊回覆的形狀（甚至跳過工具呼叫、偽造
# 「已發送 Telegram」）。預設 0 = 每次 fire 都是獨立執行（session 檔
# 仍累積完整記錄，只是 LLM 上下文乾淨）；2 = 保留前一組 Q/A 的輕量
# 連續性；-1 = 還原舊行為（帶全部歷史）。
#QDRANT_SCHEDULE_FIRE_HISTORY=0

# ── Schedule-fire memory recall (v0.9.67.2+) ──
# 每次 fire 是否注入長期記憶召回。fire 本身會把 web_search 結果存成
# 記憶（v0.9.59 kind=query），下次 fire 召回時等於把「舊股價」餵給
# 問「今天」行情的任務（v0.9.67.2 使用者回報：異常分析用了記憶裡的
# 舊股價）。預設 off = fire 只靠當次工具查詢的即時資料；設 on 可讓
# 需要「延續前次脈絡」的排程恢復記憶召回。
#QDRANT_SCHEDULE_FIRE_MEMORY=off

# ── Schedule-fire verification (v0.9.106.0+; P0 驗證前置化) ──
# 排程 fire 的「驗證三守則」流程硬擋（預設 on）。開啟時每次 fire 的
# prompt 自動附加 VERIFICATION DIRECTIVE（步驟 N 執行 → 步驟 N+1 強制
# 驗證：verify_artifact 機械式檢查 / get_chat_session 回讀工具回執；
# 驗證失敗 → 中止並如實回報，禁止產出成功結論）。事後守衛會對「宣稱
# 成功但零驗證證據」的回覆追加一次糾正補驗證回合，history.jsonl 與
# session 記錄三態 verified 旗標（true=已驗證或如實失敗 / false=未驗證
# 的成功宣稱 / 缺=未啟用）。單一排程可用 add_scheduled_task 的
# verify_required=false 退出；全域 off = 還原舊的自由格式 fire prompt。
#QDRANT_SCHEDULE_VERIFY=on

# ── Jev rerank (v0.9.83.0+; OFF by default) ──
# "Rank wide, read narrow" — cosine 召回 top-20（快但粗）→ Jev
# Decisions API 單一 call 對每段問「能直接回答查詢嗎？」（noul 機率,
# 實測 20 問一 call 0.4-0.8 秒、~$0.0002/次,重用 OPENROUTER_API_KEY,
# provider=TypeSafe）→ 只取 top-k 餵 LLM。任何失敗（缺 key/HTTP/逾時）
# 都會回落 cosine 原序 — 召回品質只升不降。
# 實證 2026-09-21：cosine 對「語意近但回答不了」的段落給 0.517 假信心,
# Jev 給 0.17（誠實）;命中段落 0.96 排最前。
# QDRANT_RERANK=on
# QDRANT_RERANK_BACKEND=jev          # nimble = 本地 9B,RDNA1 prefill
#                                    # 20 段要 40-100 秒,執行期直接拒用
# QDRANT_RERANK_CANDIDATES=20        # 召回池大小（2-50）
# QDRANT_RERANK_TIMEOUT_S=10         # HTTP timeout（2-60）
# QDRANT_RERANK_CHUNK_CHARS=600      # 每段送進 state 的截斷長度
# JEV_MODEL=typesafe/jev-1.13        # OpenRouter 目錄名;官方 API 要
#                                    # 用 jev-1.13.0（裸名會 400）
# QDRANT_RERANK_MIN_PROB=0.3         # 低置信防幻覺閘（v0.9.83.1）:
#                                    # 最高 noul < 0.3 → 回空結果
#                                    # （語料無可回答內容）；0 = 停用

# ── Jev watch gate (v0.9.84.0+; OFF by default) ──
# Teams watch fire 先走「確定性 UIA 讀取 + 一次 Jev noul 決策」
# （需要使用者本人回覆嗎？）— p ≥ 門檻 → 整個 LLM 回合跳過
# （每次誤報省 ~12k tokens + 3-5 秒）。任何失敗（UIA 讀取失敗/
# Jev 逾時/缺 key）都會 fail-open 到原本的 LLM 回合 — 漏報比浪費貴。
# 實測：單次決策 0.2-0.3 秒、~$0.00003。
# QDRANT_WATCH_GATE=on
# QDRANT_WATCH_GATE_SKIP_PROB=0.7    # p ≥ 門檻才跳過（clamp 0-1）

# ── Jev time route (v0.9.84.1+; OFF by default) ──
# 「今天是幾月幾日／現在幾點」類訊息：Jev noul 判斷（p ≥ 0.85）→
# 真呼叫 get_current_time + 模板直答，**跳過整個 LLM 工具迴圈**
# （<1 秒、省 ~12k tokens）。shadow = 只記 log 不動行為（建議先跑
# 一週累積誤判率再切 on）；任何失敗 fail-closed 回落 LLM 主路徑。
# QDRANT_TIME_ROUTE=shadow
# QDRANT_TIME_ROUTE_PROB=0.85        # p ≥ 門檻才直答（clamp 0-1）

# ── Jev message router v2 (v0.9.84.2+; OFF by default) ──
# 每回合**一次** Jev choice 呼叫把訊息分類到處理器，高信心者**跳過
# LLM 工具迴圈**：time（get_current_time 模板）/ greeting（語系模板，
# 零工具零 LLM）/ status（teams_assist_status 摘要）/ weather
# （pre-fetch：確定性 web_search → 單次 LLM 摘要，省工具迴圈往返）。
# 設定後取代 QDRANT_TIME_ROUTE；shadow 先記 log 一週再切 on。
# QDRANT_ROUTE=shadow
# QDRANT_ROUTE_PROB=0.85
# QDRANT_ROUTE_CLASSES=time,greeting,status,weather

# ── Jev dynamic tool-surface（v0.9.98.0+; OFF by default）──
# LLM 執行前用一次 Jev choice 判斷問題需要的工具類別 → 該回合表面
# = 核心群（qdrant/web/datetime/meta/filesystem）+ 類別 server 群，
# 仍受 MCP_ACTIVE_SERVERS 過濾 + MCP_SURFACE_MAX_TOOLS cap，並以
# QDRANT_TOOLROUTE_CAP（預設 128 = provider tools 陣列上限）硬頂。
# shadow = 只記 [ToolRoute] log 不套用；on = 套用；Jev 失敗/低信心/
# GUI picker 指定時一律退回原表面（fail-open）。
# QDRANT_TOOLROUTE=shadow
# QDRANT_TOOLROUTE_PROB=0.6
# QDRANT_TOOLROUTE_CAP=128
# QDRANT_TOOLROUTE_CLASSES=stock,calendar,keep,chat-history,telegram

# ── Chat voice bridge（v0.9.68.0+）──
# Web/GUI 聊天介面的語音雙向：🎤 錄音 → STT（voice_stt）、
# 回覆 🔊 → TTS（tts_speak）。共用 Telegram 語音的 SpeechClient
# 設定（TELEGRAM_STT_*/TELEGRAM_TTS_* 或 OPENROUTER_API_KEY）。
# 注意：麥克風需要安全來源（localhost 或 HTTPS）— 綁 0.0.0.0 時
# 從區網 IP 開啟的頁面會被瀏覽器擋下（127.0.0.1 不受限）。
#QDRANT_UI_VOICE_MAX_MB=8

# ── Web UI mode (v0.9.15.0+; bind-any-local-IP since v0.9.15.1) ──
# `python -m gui.app --web`（或 divine-sense-agent-web.bat）會用系統瀏覽器開啟
# Web 版介面（與 pywebview GUI 同一套前端 + Api）。綁定位址預設
# 127.0.0.1 — Api 可驅動桌面自動化與檔案工具，不建議暴露到區網；
# 綁非 loopback 位址時伺服器會記 WARNING。
# v0.9.15.1 起可綁本機任何 IP:
#   0.0.0.0        = 全部 IPv4 介面（啟動時列出所有可連的區網 URL，
#                    瀏覽器自動開 loopback URL；只用於可信區網）
#   192.168.x.x    = 只綁某個特定區網 IP
#   ::1 / ::       = IPv6（:: 為 dual-stack，同時服務 v4+v6）
QDRANT_WEB_HOST=127.0.0.1
QDRANT_WEB_PORT=8334

# ── Web UI client upload (v0.9.16.0+) ──
# Web 版聊天工具列的 📎 / 📷 按鈕可從「客戶端瀏覽器」（含手機）上傳檔案，
# 存進 filesystem 寫入沙箱的 uploads/ 子目錄（與 FilesystemLocalHost
# 同一個 root，LLM 可直接讀取 / Api.ingest_file 可攝入）。
# 單一請求的 body 大小上限(MB)。預設 200，最小 1；無效值退回預設。
#QDRANT_WEB_UPLOAD_MAX_MB=200
#
# ── Web UI chat file download (v0.9.65.0+) ──
# 下載的反方向：LLM 產出的沙箱檔案（write_file / exec_python 圖表 /
# archive / uploads/ 上傳檔）會在 chat 氣泡內顯示「⬇ 下載檔案 · 檔名」
# chip（app.js 掃描氣泡文字中的沙箱路徑，非圖片副檔名）。點擊：
#   web 模式 → 瀏覽器直接 GET /download?path=...（伺服器串流下載）
#   GUI 模式 → 原生資料夾選擇器選目的地 → save_sandbox_file_as 複製
# 安全：與 read_sandbox_image 同一套沙箱解析（import ∪ READ ∪ WRITE
# roots、相對路徑錨定 WRITE root — 絕不任意讀取）+ 危險執行檔拒絕
# + 大小上限(MB)。預設 200，最小 1；無效值退回預設。
#QDRANT_WEB_DOWNLOAD_MAX_MB=200

# ── 兆豐證券 Stock query / order tools (v0.9.24.0+) ──
# stock-local MCP 擴充（第 13 個 in-process LocalHost `MegaStockLocalHost`
# + stdio 鏡像 `python -m src.mcp_server.stock_server`）的執行模式。
#
# 6 個工具（LLM 經 MCP tool-calling 使用；gate 名單需含 stock-local）:
#   stock_get_quote(symbol)                  即時報價快照（開高低收/漲跌/量）
#   stock_get_kline(symbol, interval, bars)  K線（day|week|month, 1-200 根）
#   stock_get_account_summary()              庫存 / 權益 / 未平倉摘要
#   stock_list_orders(status, limit)         委託查詢（all|open|filled|cancelled）
#   stock_place_order(symbol, side, qty,     下單（buy|sell × limit|market）
#                     price?, order_type, confirm)
#   stock_cancel_order(order_id)             刪單（限 open 狀態）
#
# 執行模式（MEGA_STOCK_MODE）:
#   mock (預設) — 開發/測試用：完全模擬。不連線兆豐主機、不 import
#                 megaspeedy 元件、不送出任何真實委託。報價與帳務為
#                 確定性模擬資料（同一 symbol 重複查詢得一致價格，
#                 回應標記 simulated=true）；下單只存在記憶體模擬
#                 委託簿（單號 MOCK-YYYYMMDD-nnnn；市價單立即模擬
#                 成交，限價單留 open 供刪單/查詢演練）。
#   live        — 真實模式：需要 Windows + 兆豐 megaspeedy 元件 +
#                 電子憑證 .pfx + 交易主機參數。本 build 的 live 端
#                 僅含連線/登入骨架與明確的「聯調未完成」錯誤 —
#                 未經真實聯調的下單路徑一律鎖住（參考文件:
#                 https://www.emega.com.tw/emega/upload/megaapi/teach0.html）。
#
# ⚠️ 下單三道閘（全部通過才會碰到真實 MegaAPI；mock 模式無風險）:
#   1. MEGA_STOCK_MODE=live
#   2. MEGA_STOCK_TRADING_ENABLED=on（下單功能總開關，預設 off）
#   3. 每筆下單參數 confirm=true（LLM 必須明確確認，防意外下單）
#
# 開發/測試階段請保持預設 mock，不要開啟 live。live 查詢/下單在
# megaspeedy 元件安裝 + 兆豐 API 權限申請（Windows 專用軟體）完成前
# 一律回「聯調未完成」錯誤。
MEGA_STOCK_MODE=mock
#MEGA_STOCK_TRADING_ENABLED=off

# ── Telegram Bot — 雙向對話 polling daemon（v0.9.27.0+） ──
# 有別於 v0.8.1 的單向發送（send_telegram_message），開啟後 bot 會
# 長輪詢 getUpdates：白名單使用者傳給 bot 的訊息 → Agent 執行（完整
# 工具面）→ 回覆自動送回 Telegram。每個 chat 一個持久 session
# （tgbot-<chat_id>，多輪上下文）。安全：同一個
# TELEGRAM_ALLOWED_CHAT_IDS 白名單，fail-closed（空名單 = 全忽略）。
#
#   QDRANT_TELEGRAM_BOT_POLLING      on（預設）/ off 關閉雙向
#   QDRANT_TELEGRAM_BOT_POLL_INTERVAL 輪詢間隔秒數（1-30，預設 2；
#                                    長輪詢本身 10s，stop 響應 ≤ 約 12s）
#
# 純出站 HTTPS（api.telegram.org）— 不需開 port、不需 https/公網。
# GUI/web 重啟後 prewarm 自動恢復（token + 白名單 + env 三者齊備時）。
#QDRANT_TELEGRAM_BOT_POLLING=on
#QDRANT_TELEGRAM_BOT_POLL_INTERVAL=2
# v0.9.102.0 — Telegram session context discipline（session 無限成長
# 會讓 context 過多、LLM 錯亂）:
#   TELEGRAM_HISTORY_CAP            每次 fire 餵給 LLM 的歷史則數
#                                   （預設 12；≤0 或 -1 = 舊制全量）
#   TELEGRAM_SESSION_MAX_MESSAGES   session 檔的環形上限，保留最新的
#                                   N 則（預設 200；≤0/-1 = 不限）
#   in-chat 指令 /new /clear /reset（或「清除對話」「新對話」）即刻
#   清空該 chat 的 session — 使用者可自行開新對話。
#TELEGRAM_HISTORY_CAP=12
#TELEGRAM_SESSION_MAX_MESSAGES=200

# ── 兆豐 MegaAPI live 連線（v0.9.26.0+） ──
# API 權限開通後（115/09/09 通知，次日 08:30 起可登入）填入以下資訊。
# 查詢（帳務/委託/成交/K線/行情）不需憑證；「下單/刪單」另需電子憑證。
#
# 登入資訊（LogonProxy('身分證字號大寫', '電子登入密碼', '證券帳號')）:
MEGA_STOCK_ID=              # 身分證字號（大寫字母開頭），如 A123456789
MEGA_STOCK_PASSWORD=        # 電子登入密碼（下單憑證另見下方）
MEGA_STOCK_ACCOUNT=1673976  # 證券帳號（7 碼）
MEGA_STOCK_BRANCH=7000      # 分公司代碼（4 碼）
#MEGA_STOCK_MARKET=tse      # 下單市場：tse 上市 / otc 上櫃 / es 興櫃
#
# 連線主機（預設即官方值，無需覆寫）:
#MEGA_STOCK_ORDER_HOST=spapi.emega.com.tw
#MEGA_STOCK_ORDER_PORT=56789
#MEGA_STOCK_QUOTE_HOST=119.31.179.86
#MEGA_STOCK_QUOTE_PORT=34567
#
# 下單憑證（v0.9.28.2：交易主機「登入本身」就需要電子憑證 —
# EnableMEGACA 於 Connect 前呼叫；查詢 K線/帳務/委託也需要它，
# 僅行情快照不需要。憑證 = 兆豐電子憑證 .pfx，密碼為憑證密碼）:
#MEGA_STOCK_CERT_PATH=      # 兆豐電子憑證 .pfx 路徑
#MEGA_STOCK_CERT_PASSWORD=  # 憑證密碼
#
# ⚠️ 開發/測試請保持 MEGA_STOCK_MODE=mock。切換 live 只為了查詢
# 驗證（登入/帳務/K線）時，「下單」仍受三道閘保護（mode=live +
# MEGA_STOCK_TRADING_ENABLED=on + confirm=true）。

# ── live 下單前的 Telegram 同意閘（v0.9.28.0+，預設 on） ──
# live 下單送出 SendNewOrderEx 之前，強制先透過 Telegram bot 送出
# 確認請求（含唯一代碼 STK-XXXX）到指定 chat，並等待回覆
# 「同意 <代碼>」核准（或僅回覆代碼）；「拒絕 <代碼>」/逾時 → 取消
# 送單。需要 Telegram bot 輪詢運行中（QDRANT_TELEGRAM_BOT_POLLING=on）
# — bot daemon 是 getUpdates 的唯一消費者，負責接收同意回覆。
#
#   MEGA_STOCK_ORDER_APPROVAL          on（預設，強制）/ off
#   MEGA_STOCK_ORDER_APPROVAL_CHAT_ID  確認人 chat id
#                                      （預設 = 白名單第一個，即
#                                      <YOUR_TELEGRAM_CHAT_ID>；可指定其他 chat）
#   MEGA_STOCK_ORDER_APPROVAL_TIMEOUT  等待秒數（10-900，預設 180）
#
#MEGA_STOCK_ORDER_APPROVAL=on
#MEGA_STOCK_ORDER_APPROVAL_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
#MEGA_STOCK_ORDER_APPROVAL_TIMEOUT=180

# ── hicloud HWS 雲服務 MCP（v0.9.64.0+，中華電信 CaaS/CVPC） ──
# 透過官方 REST API 操作 hicloud 雲伺服器（VM）— 參考文件:
# https://hws.hicloud.hinet.net/hws-doc/zh_TW/
# server 名稱 hicloud-local；v0.9.66.0 起共 56 工具（CaaS + CVPC 完整
# 服務面，依官方文件補完）:
#   VM 生命週期: list_instances / run_instances / start / stop /
#     reboot / terminate_instances（terminate 不可逆）
#   VM 補完: modify_instance_attribute (原機升降級) / restore_instance
#   範本 Image: describe_images / image_create / image_delete / image_modify
#   運算規格: list_instance_types（runInstances 前查合法值）
#   監控 CloudWatch: get_instance_stats；平台 Log: log_list
#   儲存空間 EBS: volume_create (radix 1-20=100GB/格) / attach /
#     detach / delete / list
#   負載平衡 SLB: slb_create (CaaS instanceIds+ports；CVPC
#     vpc_bsid+load_balancer_type) / delete / list / vip_health / replace
#   子網段 Subnet: subnet_create (CVPC vpc_bsid；CaaS
#     intranet_gateway_bsid) / delete / list / modify
#   防火牆 NetworkAcl: acl_create (CaaS 舊式 / CVPC 新式 policy 字串) /
#     delete / list / replace
#   CVPC: vpc_create / delete / list / modify
#   網際網路連線: igw_create / delete / list；internet_ip_create /
#     delete / list
#   內網路由: intranet_gw_create / delete / list / modify；
#     intranet_link_create / delete / list
#   NAT/埠轉發: nat_create / delete / list；pfwd_create / delete / list
#
# 執行模式（HICLOUD_MODE）:
#   mock (預設) — 開發/測試用：完全模擬。不連線
#                 hws.hicloud.hinet.net、不送出任何真實 API 呼叫。
#                 VM/範本/生命週期操作全部在記憶體模擬
#                 （simulated=true）。
#   live        — 真實模式：需要 HICLOUD_ACCESS_KEY +
#                 HICLOUD_SECRET_KEY（hicloud 用戶平台/CloudBOSS
#                 入口取得）。
#
# ⚠️ 生命週期兩道閘（全部通過才會真正執行）:
#   1. 每次操作參數 confirm=true（防意外操作；mock 亦強制）
#   2. live 寫入另需 HICLOUD_WRITES_ENABLED=on（總開關，預設 off）
# 開發/測試請保持 HICLOUD_MODE=mock。
HICLOUD_MODE=mock
#HICLOUD_WRITES_ENABLED=off
#HICLOUD_ACCESS_KEY=        # hicloud Access Key（live 用）
#HICLOUD_SECRET_KEY=        # hicloud Secret Key（live 用，勿外洩）
#HICLOUD_TIMEOUT_S=30       # live API 呼叫逾時秒數（5-120）

# ── Webhook trigger HTTP listener (v0.9.25.0+) ──
# ── Webhook trigger HTTP listener (v0.9.25.0+) ──
# webhook-local MCP 擴充的監聽位址：每個觸發器（webhooks/<id>.json）
# 有自己的 URL（/trigger/<id>）+ access key，HTTP 呼叫即啟動預設
# prompt。設定方式與排程一致（add / list / get / delete / enable /
# disable / run-now / runs / errors — LLM 經 MCP tools 操作）。
#
#   QDRANT_WEBHOOK_HOST  綁定位址（預設 127.0.0.1；非 loopback 會記
#                        WARNING — 每個 URL 都是「遠端 prompt 執行」
#                        端點，僅受 access key 保護，勿暴露公網）
#   QDRANT_WEBHOOK_PORT  綁定埠（預設 8335）
#   QDRANT_WEBHOOK_AUTORESUME  開機自動恢復（預設 on；GUI/web 重啟
#                        後，存在 enabled 觸發器時自動重新綁定；
#                        access key 跨重啟有效）。off 可關閉。
#
# 開發/測試建議保持 127.0.0.1 預設值。
#QDRANT_WEBHOOK_HOST=127.0.0.1
#QDRANT_WEBHOOK_PORT=8335
#QDRANT_WEBHOOK_AUTORESUME=on

# ── Network scanner (v0.9.40.0+) — netscan-local MCP ──
# IP scanner + port scanner 工具（net_scan_hosts / net_scan_ports /
# net_my_interfaces）。安全預設：
#   * 只允許私網/loopback/link-local 目標；公網 IP 一律拒絕，開啟
#     ALLOW_PUBLIC 前請確認網段是「你自己有權掃的網路」。
#   * 規模上限：MAX_HOSTS 4096 / MAX_PORTS 1024（巨網/全埠直接拒絕）。
#   * 並行上限 MAX_WORKERS 128；每探測 timeout 上限 5 秒。
#
#QDRANT_NETSCAN_ALLOW_PUBLIC=off
#QDRANT_NETSCAN_MAX_HOSTS=4096
#QDRANT_NETSCAN_MAX_PORTS=1024
#QDRANT_NETSCAN_MAX_WORKERS=128
#QDRANT_NETSCAN_TIMEOUT=1.0

# ── os-input tools (v0.9.105.0+, exec-local) — REAL SendInput
#    keyboard/mouse for trusted-only fields the bridge cannot fill
#    (Teams/Outlook rich compose, M365 login tile). Chain:
#    browser_element_point → os_click_point(preview=true 先目視) →
#    os_type_text → os_key_press Enter. Fail-closed: the master gate
#    must be explicitly on; EVERY acting call additionally requires
#    confirm=true + title_regex matching the foreground window;
#    cursor is restored after clicks and everything is audited to
#    sandbox os_input/audit.jsonl.
#QDRANT_OS_INPUT_ALLOW=off
#QDRANT_OS_INPUT_MAX_TEXT=2000
#QDRANT_OS_INPUT_PACING_S=0.03
#QDRANT_OS_INPUT_MAX_WINDOWS=200

# ── Teams desktop-assist (v0.9.69.0+) — teams-assist MCP ──
# 零 Microsoft 權限的 Teams 個人助理：操作「使用者本人已登入的 Teams
# 桌面客戶端」（經 windows-mcp fleet 讀視窗/打字送出）— 不用 Teams
# API、不用 OAuth、不用 Graph 權限。訊息以使用者本人身份發出，對方
# 無感。mock-first：QDRANT_TEAMS_ASSIST_MODE=mock（預設）不截取真實
# 畫面，watch/fire 全鏈可離線演練。
#
#   QDRANT_TEAMS_ASSIST_MODE              mock（預設）/ live（真實截圖）
#   QDRANT_TEAMS_ASSIST_POLL_INTERVAL     watch 輪詢秒數（10-300，預設 15）
#   QDRANT_TEAMS_ASSIST_MIN_FIRE_INTERVAL 兩次 LLM fire 的最小間隔秒
#                                         （0-3600，預設 120 — 防洪水）
#   QDRANT_TEAMS_ASSIST_AUTO              on|off（預設 off = 只記草稿
#                                         不送出；on = 自動打字送出）
#   QDRANT_TEAMS_ASSIST_SEND_MODE         送出通道（v0.9.70.0+）:
#                                         windows-mcp（預設，合成鍵鼠，
#                                         送出瞬間會共用你的輸入流）|
#                                         uia（UI Automation 背景送出：
#                                         ValuePattern 填入 + Invoke-
#                                         Pattern 按傳送，零鍵鼠零搶焦點
#                                         — 可一邊工作一邊全自動；輸入框
#                                         有內容時自動讓路）
#   QDRANT_TEAMS_ASSIST_WATCH_MODE        偵測通道（v0.9.71.0+）:
#                                         screen（預設，64×64 像素 hash
#                                         — 畫面任何變化都是候選，靠冷卻
#                                         壓誤觸）| uia（聊天文字 hash：
#                                         UIA TextPattern 直讀聊天文字，
#                                         只有文字真的變了才觸發 LLM —
#                                         幾乎零誤觸、Teams 最小化也有效
#                                         ；UIA 讀取失敗自動退回像素
#                                         hash，watch 不會因此暫停）
#   QDRANT_TEAMS_ASSIST_FIRE_HISTORY      餵給 LLM 的 fire 歷史上限
#                                         （v0.9.74.0+；-1 = 預設，帶該
#                                         聊天完整歷史 — session 已是每
#                                         聊天獨立，成長有界；0 = 各 fire
#                                         獨立不帶歷史；N = 只帶最後 N 則
#                                         。session 檔永遠保留完整記錄）
#   QDRANT_TEAMS_ASSIST_UIA_SCRIPT        UIA 操作腳本路徑覆寫（預設用
#                                         scripts/uia_teams_ops.ps1）
#   MCP_SURFACE_MODE                      工具表面模式（v0.9.81.0+，
#                                       「精簡核心 + 按需展開」）:
#                                         full（預設，行為不變 — 完整
#                                         schema 逐欄位附上）|
#                                         index（精簡核心：非豁免
#                                         server 的工具只附「參數鍵 +
#                                         型別」的 lean schema，描述
#                                         截短 60 字 — 大幅降低 context
#                                         佔用；完整定義走「按需展開」：
#                                         呼叫失敗時錯誤訊息自動附上
#                                         完整參數定義供模型重試。
#                                         qdrant-local 與 meta-local
#                                         恆為完整 schema）
#   MCP_SURFACE_MAX_TOOLS                 工具數硬上限（v0.9.82.2+）—
#                                         多數供應商（OpenAI）tools
#                                         陣列上限 128；超過依
#                                         MCP_ACTIVE_SERVERS 列出順序
#                                         裁掉尾部（愈前面愈優先保留）。
#                                         0 = 不限
#   QDRANT_TEAMS_ASSIST_AUTORESUME        開機自動恢復 watch（預設 on）
#   TEAMS_ASSIST_ALLOW_CHATS              聊天過濾條件（v0.9.75.0+）
#                                         （逗號分隔；每項為標題完全比
#                                         對或含 * 的過濾樣式 — 加密分
#                                         持* = 以此開頭、*會議* = 標題
#                                         含此字；'*' 單獨 = 所有聊天；
#                                         空 = watch 拒絕啟動，
#                                         fail-closed）
#   TEAMS_ASSIST_WINDOW_RECT              截圖區域 x,y,w,h（Teams 視窗；
#                                         未設 = 全螢幕）
#   TEAMS_MY_NAME / TEAMS_MY_ROLE / TEAMS_REPLY_STYLE
#                                         代答人設（名字/身份脈絡/文風）
#                                         — fire prompt 自動內嵌
#
# 送出閘門（teams_assist_reply）：AUTO=off 時自動回合只能
# confirm=false 記草稿；使用者明確要求送出才 confirm=true+manual=
# true。每筆 fire/draft/sent 記入 teams_assist/state.json 審計環。
# MCP_ACTIVE_SERVERS 需含 teams-assist 才會暴露工具面（gate 契約）。
# 以上組態 LLM 皆可透過 teams_assist_config 工具「暫時」調整（只改
# process 內 os.environ，不寫本檔 — 重啟後回到這裡的值；v0.9.72.0+）。
#QDRANT_TEAMS_ASSIST_MODE=mock
#QDRANT_TEAMS_ASSIST_POLL_INTERVAL=15
#QDRANT_TEAMS_ASSIST_MIN_FIRE_INTERVAL=120
#QDRANT_TEAMS_ASSIST_AUTO=off
#QDRANT_TEAMS_ASSIST_SEND_MODE=windows-mcp
#QDRANT_TEAMS_ASSIST_WATCH_MODE=screen
#QDRANT_TEAMS_ASSIST_FIRE_HISTORY=-1
#QDRANT_TEAMS_ASSIST_UIA_SCRIPT=
#MCP_SURFACE_MODE=full
#MCP_SURFACE_MAX_TOOLS=0
#QDRANT_TEAMS_ASSIST_AUTORESUME=on
#TEAMS_ASSIST_ALLOW_CHATS=
#TEAMS_ASSIST_WINDOW_RECT=
#TEAMS_MY_NAME=
#TEAMS_MY_ROLE=
#TEAMS_REPLY_STYLE=簡潔、專業、繁體中文# ---- exec script library (v0.9.102.5+) ----  
# Successful run_python / run_bash / run_shell code blocks (200+ chars)  
# are auto-saved into (WRITE_ROOT)/scripts/ (sha1 dedup, auto- ring cap 50)  
# and stamped in the tool result (auto_saved: name) - recurring jobs then  
# replay with script_run instead of re-generating code. The three script_  
# tools stay active even when auto-save is off.  
#QDRANT_EXEC_SCRIPT_LIBRARY=on  
# Global isolation backend for PY script_run: empty = direct (inherit)  
#QDRANT_SCRIPT_RUNTIME=  
#QDRANT_SCRIPT_CONDA_ENV=  
#QDRANT_SCRIPT_DOCKER_IMAGE=python:3.12-slim  
#QDRANT_SCRIPT_DOCKER_NETWORK=none  
#QDRANT_SCRIPT_DOCKER_MEM=2g  
#QDRANT_SCRIPT_DOCKER_CPUS=2

# ---- imagegen 產圖 (v0.9.104.0+; OpenRouter dedicated Image API) ----
# 文生圖 MCP 擴充（imagegen-local: image_generate / image_gen_list /
# image_gen_models / image_gen_status）。mock（預設）= Pillow 確定性
# placeholder（不連網零費用 — simulated: true）；live 走
# POST https://openrouter.ai/api/v1/images/generations，重用
# OPENROUTER_API_KEY，每張圖收真實費用（usage.cost，實測 recraft-flash
# ~$0.007/張、gpt-image-2 ~$0.13/張）。圖檔寫進 write sandbox 的
# images/；每次產圖需 confirm=true，live 另需 IMAGEGEN_WRITES_ENABLED=on
# （總開關 — 防意外計費；與 HICLOUD/KEEP 寫入閘同款）。
#IMAGEGEN_MODE=live
#IMAGEGEN_MODEL=google/gemini-2.5-flash-image
#IMAGEGEN_WRITES_ENABLED=on
#IMAGEGEN_MAX_IMAGES=4
#IMAGEGEN_TIMEOUT_S=120
#IMAGEGEN_DIR=images
# MCP_ACTIVE_SERVERS 需含 imagegen-local 才會暴露工具面（gate 契約）。
# ── tool-result 防呆硬閘 (v0.9.104.3+) ──
# 任何單一工具回傳超過 QDRANT_TOOL_RESULT_MAX_CHARS 字元 → 截斷＋標註。
# 這道閘與壓縮器無關（offload 寫檔失敗/壓縮關閉時也擋）——事故背景：
# get_page_html 回傳 Gmail 整頁 HTML → 1,751,656 tokens 直接進 prompt →
# 全部 provider 40x、回合全毀。51200 ≈ 13k tokens；0 = 不限（同
# MCP_SURFACE_MAX_TOOLS 慣例）。
#QDRANT_TOOL_RESULT_MAX_CHARS=51200
# 另：CHAT_CONTEXT_COMPRESSION 自 v0.9.104.3 起「on / yes / true / 1」
# = auto 的別名（不再靜默失效）。

# ── v0.9.107.0 — telegram 卡關根因修補 ──
# ① offload 豁免 read_file：read_file/read_multiple 的大結果不再
#   寫 offload 檔（來源檔就在 read sandbox；再包一層是循環洋蔥 —
#   2026-10-03/04 read_file ×62/×118 風暴 → max_iterations=50 的
#   根因）。inline 仍受 QDRANT_TOOL_RESULT_MAX_CHARS 上限保護。
#   建議 CHAT_OFFLOAD_THRESHOLD_CHARS 維持 20000（6000 對
#   read_file 是自殺門檻；kline 已有專屬 compact 機制）。
# ② per-tool-call watchdog：單一工具呼叫超過 N 秒 → 回
#   [tool watchdog] tool error（loop 可反應、task-registry 必有
#   done row），失控 thread 以 daemon 棄置。0 = off（byte-identical
#   舊行為）；2026-10-04 00:06 起的 ~58 分鐘無聲掛死即此類。
QDRANT_TOOL_CALL_TIMEOUT_S=600

# ── v0.9.107.1 — telegram 回合級硬超時（最後一網） ──
# 單一 telegram chat_turn 超過 N 秒 → 強制中止：task-registry 記
# failed、session 記錄、使用者收到誠實的超時回覆（不再無聲掛死；
# 2026-10-04 00:06 與 12:22 兩次 ~49-58 分鐘零輸出掛死即此類）。
# 失控 thread 以 daemon 棄置。0 = off（舊行為）。
QDRANT_TURN_HARD_TIMEOUT_S=1800

# ── v0.9.108.0 — 背景任務併發上限 + 完成/進度通知 ──
# run_task_once 的 spawn 站併發上限（source=task 的 running 數）：
#   超限回 error + 分批指引（05:41 事故：一輪 6 併發 → provider
#   429 + token ×6 + offload 風暴）。0 = 不限（舊行為）。
QDRANT_TASK_MAX_PARALLEL=4
# 背景 task 完成（或失敗）時以 Telegram 主動推送（fail-closed：
#   需 TELEGRAM_BOT_TOKEN + allowlist；chat 預設 = 第 1 個
#   allowlisted chat，或以 QDRANT_TASK_NOTIFY_CHAT_ID 指定）。
#   off = 靜默（舊行為）。
QDRANT_TASK_NOTIFY=on
# QDRANT_TASK_NOTIFY_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
# 進度監控閘：有任務在跑時每 N 秒推送一次進度摘要；0 = off。
QDRANT_TASK_MONITOR_INTERVAL_S=300
# runtime 自查：LLM 可隨時以 get_runtime_status 讀取 resolved
#   limits（turn_gate / MAX_TOOL_ITERATIONS / watchdogs /
#   task_running 數）— 規劃批次與長工前先查。

# ── v0.9.109.0 — Skill/Workflow 戰術編譯器（tacti-local）──────
# 把「需多個回合分工、非單一回合可完成」的工作 compile 成
# wave-plan 再執行：compile_plan → run_plan（波次驅動 + 每 stage
# 獨立回合 + verify_artifact 機械驗證）。MCP_ACTIVE_SERVERS
# 需含 tacti-local。
# 每 stage 的 wall-clock 硬超時（秒；0 = off）。
QDRANT_SKILL_STAGE_TIMEOUT_S=1800
# v0.9.117.0 — 硬超時仲裁（巨量合法工作不再冤殺）：到期點判決
#   ① tool 派發數成長（liveness）→ 加窗（免費、確定性）
#   ② 靜音 stage → live Jev 分類 normal_long_work（prob ≥ 地板）→ 加窗
# 加窗上限（每 stage；0 = off = 舊行為：到期即棄置判 failed）
QDRANT_SKILL_STAGE_TIMEOUT_EXTENSIONS=3
# Jev 仲裁開關（on 預設；off/mock/錯誤/低信心 = 照舊 kill）
#QDRANT_SKILL_TIMEOUT_JEV=on
# 加窗需要的最低信心（0.05–0.99）
#QDRANT_SKILL_TIMEOUT_JEV_MIN_PROB=0.5
# ── v0.9.118.0 — Telegram 回合同款仲裁（turn_arbiter 共用）──
# Telegram chat_turn 硬超時（QDRANT_TURN_HARD_TIMEOUT_S，1800）到期時：
# tool 派發成長（liveness）或 live Jev normal_long_work → 加窗續跑；
# 加窗上限（0 = off = 舊行為單窗即棄置）。Jev 仲裁共用上面的
# QDRANT_SKILL_TIMEOUT_JEV / QDRANT_TIMEOUT_JEV（別名等價）。
#QDRANT_TURN_HARD_TIMEOUT_EXTENSIONS=3
# 每波最多並行的 stage 數（依賴決定波次；此數僅分批）；0 = 不限。
QDRANT_SKILL_WAVE_CAP=4
# plans/<id>.json 的存放目錄覆寫（預設 $QDRANT_RAG_HOME/plans）。
#QDRANT_SKILL_PLANS_DIR=
#
# ── v0.9.111.0 — plan/stage 工具作用域 + 交接檔 + fire 模型 pin ──
# compile_plan 名義欄位（不放 .env）：plan/stage 級 tools_allow
#   （工具白名單，於 chat_turn(active_tool_names=…) 機制化強制，
#   未指定 = 完整工具面）；Schedule/WebhookTrigger/plan 的
#   llm="provider:model"（fire/stage 模型 pin；ADD 時對目錄驗證，
#   fire 時失效自動降級預設鏈）。交接檔 out/<stage_id>.json 寫在
#   QDRANT_FILESYSTEM_WRITE_ROOT 下的 out/。
#
# ── v0.9.111.0 — 長期記憶使用追蹤（v0.9.59 記憶群組補完）──
# ① recall 命中簿記：被注入 LONG-TERM MEMORY 的點 hit_count++
#   + last_hit（fire-and-forget thread，不擋回合）；off = 不寫。
#QDRANT_MEMORY_HIT_STATS=off
# ② 任務/plan 結論沉澱：run_task_once / skill plan 終局把結論存成
#   kind=task-result（store-NOT-recall：自動召回排除此 kind，
#   需要時 search_memory(kind='task-result') 主動查 — 沿用
#   v0.9.67.2 fire 記憶教訓的隔離設計）。off = 關閉沉澱。
#QDRANT_TASK_MEMORY_SINK=off

# ── v0.9.116.0 — 技能檔案庫（skill-library-local）──────────────
# Claude-style SKILL.md 檔案包的匯入/查詢/刪除/引用管理：一技能一資料夾
# （SKILL.md + references/ examples/ 附屬檔 + _skill_meta.json 來源記錄）。
# 匯入/刪除 confirm=true 閘；引用 = skill_use 內文直接進回合。
# MCP_ACTIVE_SERVERS 需含 skill-library-local。
# 技能庫根目錄（預設 $QDRANT_RAG_HOME/skills）。
#QDRANT_SKILLS_DIR=
# 單檔大小上限（bytes；匯入複製時，超過的檔案 skip + note）。
#QDRANT_SKILL_FILE_MAX_BYTES=2000000
# 單一技能包檔案數上限（超過 = 整批拒絕，fail-closed）。
#QDRANT_SKILL_LIB_MAX_FILES=64
# skill_get / skill_use 回傳內文上限（字元；0 = 仍用預設 20000）。
#QDRANT_SKILL_LIB_BODY_CHARS=20000

# ── Web UI 可選 HTTPS（v0.9.126.0/126.1；PWA 安裝需要 secure context）──
# 擇一；全部未設 = 純 http（既有行為不變）。
#   (0) 本機現成可信憑證（實例：kidmen-web 專案的 GoDaddy 憑證，
#       SAN=tchtool.app；公網 DNS tchtool.app → 192.168.50.154 已指到
#       本機）→ 手機/平板以「憑證名稱」訪問＝無警告、PWA 安裝直接通：
#QDRANT_WEB_TLS_CERT=C:\Users\humphery\coding\kidmen-web\ssl\cert.pem
#QDRANT_WEB_TLS_KEY=C:\Users\humphery\coding\kidmen-web\ssl\key.pem
#QDRANT_WEB_TLS_NAME=tchtool.app
#   (1) 任意現成 PEM 對（兩者都設才生效；檔案不存在 = 誠實退 http）
#QDRANT_WEB_TLS_CERT=
#QDRANT_WEB_TLS_KEY=
#   (2) 自動自簽（SAN 含 127.0.0.1/::1/全部區網 IP；產在
#       $QDRANT_RAG_HOME/certs/、重啟重用；手機 Firefox 先「接受風險
#       一次」再安裝；Chrome 對自簽可能仍拒裝 → 用 android/ 的 APK）
#QDRANT_WEB_TLS_AUTO=on

# ── Web 上傳 body 上限 MB（v0.9.16.0；預設 200）──
#QDRANT_WEB_UPLOAD_MAX_MB=200

# ── v0.9.127.0 — 自我優化五項（plan→skill 固化 / 規則療效度控 /
#   記憶維護 / 驗證者異源 / ToolRoute 可修訂化）──
# ① 成功 plan 自動草擬 SKILL.md（僅草稿、永不自動入庫；複核後
#    skill_import(source=<資料夾>, confirm=true)）。off = 關閉。
#QDRANT_PLAN_SKILL_DRAFT=off
#QDRANT_PLAN_SKILL_DRAFT_MIN_STAGES=3
#QDRANT_SKILL_DRAFTS_DIR=
# ② 規則療效度控（每條規則生效期間的工具失敗計數 errors/last_error；
#    只記數字不進快照 ring）。off = 關閉。
#QDRANT_RULEBOOK_TELEMETRY=off
# ③ 每週記憶維護排程（on = 開機自動建「記憶維護（每週）」cron 0 9 * * 1，
#    只回報 suggest_memory_cleanup 候選、絕不自動清除）。
#QDRANT_MEMORY_MAINTENANCE=on
# v0.9.133.3 — T+1 session-summary compaction (UniiChat memory-tree
# inspired): set the CRON to auto-create the daily precipitation
# schedule (fire prompt drives summarize_sessions → kind=session-summary
# into memory_docs, session_id back-linked, idempotent, verified by
# exact payload read-back). Empty = off. LLM pin defaults to
# ollama:qwen2.5:7b (cheap local CPU pass).
#QDRANT_SESSION_SUMMARY_CRON=0 3 * * *
#QDRANT_SESSION_SUMMARY_LLM=ollama:qwen2.5:7b
# 本機 ollama server URL（compactor 專用——OLLAMA_BASE_URL 是聊天/視覺
# 鏈的雲端端點 https://ollama.com/v1，動它會拆掉雲端模型；本工具要的是
# 本機推理，所以有專屬鍵）：
#QDRANT_SESSION_SUMMARY_OLLAMA_URL=http://127.0.0.1:11434/v1
# 本機 llama.cpp chat server URL（compactor 專用；llamacpp:<alias> pin
# 用——CPU-only qwen2.5-7b 跑在 8090，啟動器
# C:\llama.cpp\start-llamacpp-chat-cpu.bat；與 AMD 上的嵌入伺服器分開）：
#QDRANT_SESSION_SUMMARY_LLAMACPP_URL=http://127.0.0.1:8090/v1
# v0.9.133.11 — 當 task pin 打到本機 llamacpp（12k ctx CPU server），
# 工具面與此列表交集（500 工具 schema 實測 27,174 tokens > 12,288 ctx
# → 400；本機弱模型只需要小工具面）：
#QDRANT_LLAMACPP_PIN_SERVERS=memory-local,datetime-local,meta-local
#QDRANT_SESSION_SUMMARY_SINK=off
# ④ 驗證糾正回合改用「另一個」provider 模型（task_llm 可 pin 的
#    openrouter/ollama；單供應商環境自動退回原回合行為）。off = 舊行為。
#QDRANT_VERIFIER_ALT_PIN=off
# ⑤ ToolRoute 觸發列增補（agent_toolroute.md，LLM 提議 + evidence 門）：
#    shadow = 命中只進 log（預設，先看軌跡）；on = union 掛工具面；off。
#QDRANT_TOOLROUTE_OVERRIDES=on
#QDRANT_TOOLROUTE_OVERRIDES_FILE=
